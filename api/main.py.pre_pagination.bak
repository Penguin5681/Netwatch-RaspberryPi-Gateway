@app.get("/api/v1/scans", tags=["Devices"])
def list_scans(
    limit: int = Query(50, ge=1, le=500),
):
    with db_session() as db:
        rows = db.execute("""
            SELECT *
            FROM scan_runs
            ORDER BY id DESC
            LIMIT ?
        """, (limit,)).fetchall()

    return {
        "count": len(rows),
        "scans": [dict(row) for row in rows],
    }
