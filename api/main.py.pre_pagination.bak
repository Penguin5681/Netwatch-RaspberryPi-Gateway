@app.get("/api/v1/incidents", tags=["Incidents"])
def list_incidents(
    status: Literal[
        "open",
        "acknowledged",
        "resolved",
        "false_positive",
    ] | None = None,
    severity: Literal[
        "informational",
        "low",
        "medium",
        "high",
        "critical",
    ] | None = None,
    limit: int = Query(100, ge=1, le=500),
):
    query = "SELECT * FROM incidents WHERE 1=1"
    params = []

    if status:
        query += " AND status = ?"
        params.append(status)

    if severity:
        query += " AND severity = ?"
        params.append(severity)

    query += " ORDER BY updated_at DESC LIMIT ?"
    params.append(limit)

    with db_session() as db:
        rows = db.execute(query, params).fetchall()

    return {
        "count": len(rows),
        "incidents": [dict(row) for row in rows],
    }


@app.get("/api/v1/incidents/{incident_id}", tags=["Incidents"])
def get_incident(incident_id: int):
    with db_session() as db:
        incident = db.execute("""
            SELECT *
            FROM incidents
            WHERE id = ?
        """, (incident_id,)).fetchone()

        if incident is None:
            raise HTTPException(
                status_code=404,
                detail="Incident not found.",
            )

        events = db.execute("""
            SELECT e.*
            FROM security_events AS e
            JOIN incident_events AS ie
                ON ie.event_id = e.id
            WHERE ie.incident_id = ?
            ORDER BY e.window_start, e.id
        """, (incident_id,)).fetchall()

        notes = db.execute("""
            SELECT *
            FROM incident_notes
            WHERE incident_id = ?
            ORDER BY id
        """, (incident_id,)).fetchall()

    event_data = [
        decode_json_field(dict(row), "evidence_json")
        for row in events
    ]

    return {
        "incident": dict(incident),
        "events": event_data,
        "notes": [dict(row) for row in notes],
    }


@app.patch("/api/v1/incidents/{incident_id}", tags=["Incidents"])
def update_incident(
    incident_id: int,
    payload: IncidentStatusUpdate,
):
    now = utc_now()
    new_status = payload.status

    with db_session() as db:
        incident = db.execute("""
            SELECT id
            FROM incidents
            WHERE id = ?
        """, (incident_id,)).fetchone()

        if incident is None:
            raise HTTPException(
                status_code=404,
                detail="Incident not found.",
            )

        db.execute("""
            UPDATE incidents
            SET status = ?, updated_at = ?
            WHERE id = ?
        """, (new_status, now, incident_id))

        db.execute("""
            UPDATE security_events
            SET status = ?
            WHERE id IN (
                SELECT event_id
                FROM incident_events
                WHERE incident_id = ?
            )
        """, (new_status, incident_id))

    return {
        "incident_id": incident_id,
        "status": new_status,
        "updated_at": now,
    }


@app.post(
    "/api/v1/incidents/{incident_id}/notes",
    tags=["Incidents"],
)
def create_incident_note(
    incident_id: int,
    payload: IncidentNoteCreate,
):
    now = utc_now()

    with db_session() as db:
        incident = db.execute("""
            SELECT id
            FROM incidents
            WHERE id = ?
        """, (incident_id,)).fetchone()

        if incident is None:
            raise HTTPException(
                status_code=404,
                detail="Incident not found.",
            )

        cursor = db.execute("""
            INSERT INTO incident_notes (
                incident_id,
                author,
                note,
                created_at
            )
            VALUES (?, ?, ?, ?)
        """, (
            incident_id,
            payload.author,
            payload.note.strip(),
            now,
        ))

        note_id = cursor.lastrowid

        db.execute("""
            UPDATE incidents
            SET updated_at = ?
            WHERE id = ?
        """, (now, incident_id))

    return {
        "note_id": note_id,
        "incident_id": incident_id,
        "author": payload.author,
        "note": payload.note.strip(),
        "created_at": now,
    }


